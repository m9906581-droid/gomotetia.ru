<title>Россия: 900 — 2026</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;800&family=Inter:wght@400;500&display=swap">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--ink:#f5f3ee;--card:rgba(10,14,30,.62);--serif:"Playfair Display",Georgia,serif;--sans:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:90px}
body{margin:0;font-family:var(--sans);color:var(--ink);background:#1b1f4b;-webkit-text-size-adjust:100%}
#sky{position:fixed;inset:0;z-index:-2}
#clouds{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.cw{position:absolute;will-change:transform}
.c{width:100%;height:100%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,255,255,.8),rgba(255,255,255,.3) 60%,transparent);filter:blur(14px);animation:drift var(--t) linear infinite alternate}
@keyframes drift{from{transform:translateX(-12vw)}to{transform:translateX(12vw)}}
#bar{position:fixed;top:0;left:0;height:3px;width:0;background:#ffd27a;z-index:30}
nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:20;display:flex;gap:8px;padding:12px 14px;overflow-x:auto;scrollbar-width:none;background:linear-gradient(rgba(0,0,0,.35),transparent)}
nav::-webkit-scrollbar{display:none}
nav button{flex:none;font:500 13px var(--sans);color:var(--ink);background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.3);border-radius:99px;padding:8px 14px;cursor:pointer;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);touch-action:manipulation}
nav button.on{background:#ffd27a;color:#1a1a2e;border-color:#ffd27a}
#yr{position:fixed;left:0;right:0;bottom:calc(6px + env(safe-area-inset-bottom,0px));text-align:center;font:800 clamp(48px,14vw,120px)/1 var(--serif);opacity:.2;z-index:1;pointer-events:none;transition:opacity .3s}
header{min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:90px 20px 40px}
h1{font:800 clamp(44px,12vw,120px)/1.02 var(--serif);margin:0;text-shadow:0 6px 40px rgba(0,0,0,.45)}
header p{max-width:34ch;font-size:clamp(16px,2.6vw,21px);opacity:.9;margin:18px 0 28px}
.btn{font:500 16px var(--sans);color:#1a1a2e;background:#ffd27a;border:0;border-radius:99px;padding:14px 28px;cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.35);touch-action:manipulation}
main{position:relative;z-index:2;max-width:980px;margin:0 auto;padding:0 16px 30vh}
.era{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.era h2{font:800 clamp(38px,10vw,92px)/1.05 var(--serif);margin:0;letter-spacing:.4em;opacity:0;transition:letter-spacing 1.4s ease,opacity 1s;text-shadow:0 6px 40px rgba(0,0,0,.5)}
.era span{font:500 18px var(--sans);opacity:0;transition:opacity 1.4s .5s;margin-top:12px}
.era.in h2{letter-spacing:0;opacity:1}.era.in span{opacity:.9}
.ev{min-height:78vh;display:flex;align-items:center;padding:5vh 0}
.ev:nth-of-type(even){justify-content:flex-end}
.card{width:min(100%,520px);background:var(--card);border:1px solid rgba(255,255,255,.18);border-radius:22px;overflow:hidden;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 20px 60px rgba(0,0,0,.4);opacity:0;transform:translateY(50px) scale(.96);transition:opacity .7s,transform .8s}
.ev.in .card{opacity:1;transform:perspective(900px) translateZ(var(--z,0px)) rotateX(var(--rx,0deg));filter:blur(var(--b,0px));transition:opacity .7s}
.sc{cursor:pointer;clip-path:circle(0% at 50% 60%);transition:clip-path 1.2s ease .15s;-webkit-tap-highlight-color:transparent}
.ev.in .sc{clip-path:circle(80% at 50% 50%)}
.sc svg{display:block;width:100%;height:auto}
.sc text{font:700 16px var(--sans)}
.tx{padding:18px 22px 22px}
