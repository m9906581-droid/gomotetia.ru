#b3ky{position:absolute;right:10px;top:calc(100px + env(safe-area-inset-top,0px));font:600 14px var(--sans);color:#fff;background:rgba(200,70,20,.9);border:0;border-radius:14px;padding:11px 14px;touch-action:manipulation}
#b3hl,#b3in{position:absolute;right:10px;font:600 14px var(--sans);color:#fff;border:0;border-radius:14px;padding:11px 14px;touch-action:manipulation}#b3hl{top:calc(146px + env(safe-area-inset-top,0px));background:rgba(40,110,60,.92)}#b3in{top:calc(192px + env(safe-area-inset-top,0px));background:rgba(80,80,160,.92)}
