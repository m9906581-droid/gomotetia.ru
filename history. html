.tx h3{font:600 21px/1.25 var(--serif);margin:8px 0}
.tx p{margin:0;font-size:16px;line-height:1.55;opacity:.92}
.hint{display:block;font:500 12px var(--sans);opacity:.65;margin-top:10px;font-style:normal}
footer{position:relative;z-index:2;text-align:center;padding:0 20px 26vh}
footer p{font:600 clamp(22px,5vw,36px)/1.3 var(--serif);margin:0 0 22px;text-shadow:0 4px 30px rgba(0,0,0,.4)}
.ev:not(.vis) .sc svg *{animation-play-state:paused!important}
.bob{animation:bb 1.1s ease-in-out infinite alternate}@keyframes bb{to{transform:translateY(-2px)}}
.hd{transform-origin:0 -35px;animation:nd 1.6s ease-in-out infinite alternate}@keyframes nd{from{transform:rotate(-5deg)}to{transform:rotate(7deg)}}
.wave{animation:wv 1s ease-in-out infinite alternate}@keyframes wv{from{transform:rotate(-115deg)}to{transform:rotate(-165deg)}}
.thr{animation:th .55s ease-in-out infinite alternate}@keyframes th{from{transform:rotate(-70deg)}to{transform:rotate(-105deg)}}
.pt{animation:pt 2s ease-in-out infinite alternate}@keyframes pt{from{transform:rotate(-82deg)}to{transform:rotate(-104deg)}}
.wr{animation:wr .3s ease-in-out infinite alternate}@keyframes wr{from{transform:rotate(-30deg)}to{transform:rotate(-46deg)}}
.cl{animation:cl 16s ease-in-out infinite alternate}@keyframes cl{to{transform:translateX(30px)}}
.run{animation:run 6s linear infinite}@keyframes run{from{transform:translateX(-90px)}to{transform:translateX(490px)}}
.gal{animation:gl .3s ease-in-out infinite alternate}@keyframes gl{to{transform:translateY(-3px)}}
.tw,.sun{animation:tw 2.4s ease-in-out infinite alternate;transform-box:fill-box;transform-origin:center}@keyframes tw{from{opacity:.3;transform:scale(.75)}to{opacity:1;transform:scale(1.12)}}
.fl{animation:fl .45s ease-in-out infinite alternate;transform-box:fill-box;transform-origin:50% 100%}@keyframes fl{from{transform:scale(1,.82)}to{transform:scale(1.1,1.12)}}
.fw{animation:fw 1.1s ease-in-out infinite alternate;transform-box:fill-box;transform-origin:0 50%}@keyframes fw{from{transform:skewY(-5deg)}to{transform:skewY(5deg) scaleX(.93)}}
.sw{animation:sw 3.5s ease-in-out infinite alternate}@keyframes sw{to{transform:translate(10px,-3px)}}
.wv2{animation:w2 3s ease-in-out infinite alternate}@keyframes w2{to{transform:translateX(-20px)}}
.sn{animation:sn 5s linear infinite}@keyframes sn{from{transform:translateY(-10px)}to{transform:translateY(250px)}}
.fall,.ch1,.ch2{transform-box:fill-box;transform-origin:center}
.fall{animation:fa 3.5s ease-in infinite}@keyframes fa{0%{transform:translate(0,0) rotate(0)}100%{transform:translate(10px,90px) rotate(160deg);opacity:0}}
.ch1{animation:c1 3s ease-in infinite}@keyframes c1{0%{transform:none}100%{transform:translate(-34px,80px) rotate(-50deg);opacity:0}}
.ch2{animation:c2 3s ease-in infinite}@keyframes c2{0%{transform:none}100%{transform:translate(34px,80px) rotate(50deg);opacity:0}}
.lift{animation:li 4s ease-in-out infinite}@keyframes li{0%,45%{transform:translateY(-34px)}75%,100%{transform:translateY(0)}}
.ar{animation:ar 3s linear infinite}@keyframes ar{0%{opacity:0;transform:translate(0,0)}10%{opacity:1}50%{transform:translate(70px,-34px)}90%{opacity:1}100%{opacity:0;transform:translate(140px,12px)}}
.ar2{animation:ae 3s linear infinite}@keyframes ae{0%{opacity:0;transform:translate(0,0)}10%{opacity:1}50%{transform:translate(-70px,-34px)}90%{opacity:1}100%{opacity:0;transform:translate(-140px,12px)}}
.ss{animation:ss 5s linear infinite}@keyframes ss{0%{opacity:0;transform:translate(0,0)}10%{opacity:1}40%,100%{opacity:0;transform:translate(-170px,70px)}}
.ct{animation:ct 14s ease-in-out infinite alternate}@keyframes ct{to{transform:translateX(-110px)}}
.sl{animation:sl 6s ease-in-out infinite alternate}@keyframes sl{from{transform:rotate(-18deg)}to{transform:rotate(18deg)}}
.rf{animation:rf 7s ease-in infinite}@keyframes rf{0%{transform:none;opacity:1}45%{transform:translateY(100px);opacity:1}55%,100%{transform:translateY(100px);opacity:0}}
.rs{animation:rs 7s ease-out infinite}@keyframes rs{0%,45%{transform:translateY(110px);opacity:0}55%{opacity:1}100%{transform:none;opacity:1}}
.pl{animation:pl 12s linear infinite}@keyframes pl{from{transform:translateX(-60px)}to{transform:translateX(480px)}}
.gl{animation:pl 15s linear infinite}
.ski{animation:ski 5s linear infinite}@keyframes ski{from{transform:translate(0,0)}to{transform:translate(170px,58px)}}
.ea{animation:ea .6s ease-in-out infinite alternate}@keyframes ea{to{transform:scaleY(.78)}}
.bu{animation:bu 2.8s ease-out infinite;transform-box:fill-box;transform-origin:center}@keyframes bu{0%{transform:scale(.1);opacity:1}75%{opacity:1}100%{transform:scale(1.7);opacity:0}}
.sh{animation:sh 4s ease-out infinite;transform-box:fill-box;transform-origin:center;opacity:0}@keyframes sh{0%,70%{opacity:0;transform:scale(.3)}75%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.8)}}
.bl{animation:bl 4s linear infinite;opacity:0}@keyframes bl{0%,72%{opacity:0;transform:none}74%{opacity:1}100%{opacity:0;transform:translate(150px,-26px)}}
.zap .sh,.zap .bl{animation-duration:.8s}
.rk{animation:vb .1s linear infinite alternate}@keyframes vb{to{transform:translateX(.9px)}}
.zap .rk{animation:up 2.4s ease-in forwards}@keyframes up{to{transform:translateY(-300px)}}
[hidden]{display:none!important}
.era{min-height:80vh;flex-direction:row;padding:6vh 0}
.cv{position:relative;width:min(100%,760px);aspect-ratio:16/10;border-radius:24px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.5);opacity:0;transform:scale(.92);transition:opacity 1s,transform 1.2s}
.era.in .cv{opacity:1;transform:none}
.cv>svg{position:absolute;inset:0;width:100%;height:100%;animation:kb 18s ease-in-out infinite alternate}
@keyframes kb{to{transform:scale(1.14) translate(-2%,-1%)}}
.ov{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:16px;background:linear-gradient(rgba(0,0,0,.2),rgba(0,0,0,.62))}
.ov h2{font:800 clamp(32px,9vw,80px)/1.05 var(--serif);margin:0;letter-spacing:.4em;opacity:0;transition:letter-spacing 1.6s ease .3s,opacity 1s .3s;text-shadow:0 6px 40px #000}
.era.in .ov h2{letter-spacing:0;opacity:1}
.era:not(.vis) svg *,.era:not(.vis) .cv>svg{animation-play-state:paused!important}
#grain{position:fixed;inset:-50%;z-index:55;pointer-events:none;opacity:.12;mix-blend-mode:overlay;background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");animation:gr .6s steps(4) infinite}
@keyframes gr{25%{transform:translate(-3%,2%)}50%{transform:translate(2%,-3%)}75%{transform:translate(-2%,-2%)}}
body.nocine #grain,body.nocine .sc::after{display:none}
.sc{position:relative}
.sc::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 45%,transparent 55%,rgba(0,0,0,.45)),linear-gradient(115deg,transparent 40%,rgba(255,255,255,.14) 50%,transparent 60%);background-size:100% 100%,250% 100%;animation:gs 6s ease-in-out infinite alternate}
@keyframes gs{from{background-position:0 0,100% 0}to{background-position:0 0,0 0}}
body:not(.nocine) .sc svg,body:not(.nocine) .cv>svg{filter:saturate(.9) contrast(1.08)}
.sc svg{transition:transform .25s}
body.short .tx p{display:none}
.bb{margin-top:12px;font-size:15px;padding:11px 20px;background:linear-gradient(135deg,#ff7a45,#ffd27a)}
.xb{position:absolute;top:10px;right:10px;width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);color:var(--ink);font-size:16px;cursor:pointer;z-index:2}
#bt{position:fixed;inset:0;z-index:50;background:rgba(5,8,20,.88);display:flex;align-items:center;justify-content:center;padding:14px;overflow:auto;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.bx{position:relative;width:min(100%,680px);max-height:100%;overflow:auto;background:#10162e;border:1px solid rgba(255,255,255,.2);border-radius:20px;padding:18px}
.bx h3{font:600 20px/1.25 var(--serif);margin:0 44px 12px 0}
#btc{display:block;border-radius:12px;max-width:100%}
#bts{text-align:center;padding:14px 0 4px}#bts p,.nt{font-size:15px;line-height:1.5;opacity:.9}
.rs2{font:800 34px var(--serif);text-align:center;margin:14px 0 6px}
.lb{font-size:13px;opacity:.7;margin:10px 0 4px}
.br{height:16px;border-radius:8px;background:rgba(255,255,255,.12);overflow:hidden;margin:4px 0 2px}.br i{display:block;height:100%;width:0;transition:width 1.6s ease}
.bl2{font-size:13px;margin-bottom:8px}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:10px}
.cols h4{margin:0 0 6px;font:600 16px var(--serif);color:#ffd27a}.cols ul{margin:0;padding-left:18px;font-size:14px;line-height:1.45}.cols li{margin-bottom:6px}
@media (max-width:520px){.cols{grid-template-columns:1fr}}
#b3{position:fixed;inset:0;z-index:52;background:#000;touch-action:none;user-select:none;-webkit-user-select:none}
#b3c{position:absolute;inset:0;width:100%;height:100%;display:block}
#b3h{position:absolute;top:calc(8px + env(safe-area-inset-top,0px));left:8px;right:8px;display:flex;gap:6px;flex-wrap:wrap}
#b3h button{font:500 13px var(--sans);color:#fff;background:rgba(10,14,30,.6);border:1px solid rgba(255,255,255,.3);border-radius:99px;padding:8px 12px;cursor:pointer;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);touch-action:manipulation}
#b3h button.on{background:#ffd27a;color:#1a1a2e}
#b3s{position:absolute;left:12px;right:12px;bottom:calc(10px + env(safe-area-inset-bottom,0px));font:500 14px/1.4 var(--sans);color:#fff;text-shadow:0 1px 6px #000;white-space:pre-line;pointer-events:none;text-align:center}
#b3j{position:absolute;left:20px;bottom:calc(76px + env(safe-area-inset-bottom,0px));width:120px;height:120px;border-radius:50%;border:2px solid rgba(255,255,255,.4);background:rgba(255,255,255,.08);touch-action:none}
#b3j i{position:absolute;left:35px;top:35px;width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.5)}
#b3a{position:absolute;right:22px;bottom:calc(86px + env(safe-area-inset-bottom,0px));width:88px;height:88px;border-radius:50%;font-size:34px;border:0;background:rgba(255,90,60,.88);color:#fff;touch-action:none}

#tm{position:fixed;left:0;right:0;bottom:0;z-index:45;padding:12px;padding-bottom:calc(12px + env(safe-area-inset-bottom,0px))}
.tb{position:relative;max-width:560px;margin:0 auto;background:#10162e;border:1px solid rgba(255,255,255,.25);border-radius:20px;padding:18px;text-align:center;box-shadow:0 -10px 50px rgba(0,0,0,.5)}
#tmy{display:block;font:800 54px/1 var(--serif);color:#ffd27a}
#tmr{width:100%;margin:14px 0;accent-color:#ffd27a}#tmn{font-size:15px;margin:0 0 12px}
#dock{position:fixed;right:12px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:40;display:flex;flex-direction:column;align-items:flex-end;gap:8px}
#dk{display:flex;flex-direction:column;gap:8px}
#dk button{display:flex;flex-direction:column;align-items:center;justify-content:center;width:62px;height:56px;border-radius:16px;border:1px solid rgba(255,255,255,.3);background:rgba(10,14,30,.72);color:var(--ink);font-size:20px;cursor:pointer;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);touch-action:manipulation}
#dk small{font:500 10px var(--sans)}#dk button.on{background:#ffd27a;color:#1a1a2e}
#fab{width:52px;height:52px;padding:0;border-radius:50%;font-size:22px}
.sp{position:fixed;width:7px;height:7px;margin:-3px;border-radius:50%;background:#ffd27a;z-index:60;pointer-events:none;animation:sp .7s ease-out forwards}@keyframes sp{to{transform:translate(var(--x),var(--y)) scale(.2);opacity:0}}
#fx{position:fixed;inset:0;z-index:-1;pointer-events:none;width:100%;height:100%}
#fl2{position:fixed;inset:0;z-index:35;background:#fff;opacity:0;pointer-events:none}#fl2.go{animation:fl2 .9s ease-out}@keyframes fl2{0%{opacity:.65}100%{opacity:0}}
#b3f{position:absolute;inset:0;pointer-events:none;opacity:0;background:radial-gradient(transparent 40%,rgba(200,0,0,.8))}
#b3hp{position:absolute;left:12px;top:calc(100px + env(safe-area-inset-top,0px));width:min(46vw,200px);height:10px;border-radius:5px;background:rgba(0,0,0,.5);overflow:hidden}
#b3hp i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#e33,#7d7)}
#b3d{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:rgba(0,0,0,.84);color:#fff;font:800 38px var(--serif);text-align:center}
#b3d.on{display:flex;animation:fi 1s}@keyframes fi{from{opacity:0}}
#b3b{position:absolute;right:30px;bottom:calc(184px + env(safe-area-inset-bottom,0px));width:68px;height:68px;border-radius:50%;font-size:28px;border:0;background:rgba(60,130,255,.85);color:#fff;touch-action:none}
#b3ch{position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px;border-radius:50%;background:rgba(255,255,255,.85);pointer-events:none}
#b3sc{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 50%,transparent 0,transparent 26vmin,#000 27vmin)}
#b3sc::before{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:#000}#b3sc::after{content:"";position:absolute;top:0;bottom:0;left:50%;width:1px;background:#000}
